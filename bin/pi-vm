#!/usr/bin/env bash
# pi-vm: run a pi handoff inside a microVM, on a throwaway clone of the repo.
#
#   pi-vm run [--model ID] [--thinking LEVEL] [--routing JSON] "<prompt>"
#                           clone the repo (plus .handoff/) and run pi in a VM; prints the run dir
#   pi-vm brief [same flags] "<brief>"
#                           the same VM and clone without a plan: the brief goes straight to pi,
#                           with no Files to touch, no Acceptance list and no scope check
#   pi-vm diff <run-dir> [--stat]
#                           the run's changes as a patch (made in a VM, never by host git)
#   pi-vm exec <run-dir> -- <cmd...>
#                           run a command (e.g. an Acceptance check) in a VM on the run's files,
#                           with the network but without the API key
#   pi-vm apply <run-dir>   copy the run's changes into the repo as uncommitted changes
#   pi-vm clean <run-dir>   delete a run (or --all)
#   pi-vm list              list runs
#   pi-vm log [run-dir]     follow a run's log live (default: the newest run); Ctrl+C stops watching
#   pi-vm model [ID]        show the default model, or check that ID exists on OpenRouter
#   pi-vm set-key           save OPENROUTER_API_KEY to ~/.bashrc.d/openrouter.sh (asks for it)
#   pi-vm build             (re)build the image, e.g. after editing image/
#   pi-vm update            rebuild with the newest pi from npm, if it is newer than the image's
#
# Inside the VM pi has full access (pi has no sandbox or approvals). The VM only sees the clone,
# the OpenRouter key and the network: no SSH keys, no gh token, no git remote, so it cannot push.
set -euo pipefail

CONFIG=${PI_VM_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/pi-vm/config}
# Precedence: run flags, then PI_VM_* environment variables, then the config file, then the
# defaults below. The config sets plain variables, so keep any PI_VM_* already in the environment
# and put them back after sourcing it.
env_vars=
vars=("${!PI_VM_@}")
(( ${#vars[@]} )) && env_vars=$(declare -p "${vars[@]}")
unset vars
# shellcheck disable=SC1090
[[ -f $CONFIG ]] && source "$CONFIG"
eval "$env_vars"
unset env_vars

MODEL=${PI_VM_MODEL:-xiaomi/mimo-v2.6-flash}   # an OpenRouter model ID
THINKING=${PI_VM_THINKING:-low}                # off|minimal|low|medium|high|xhigh
# OpenRouter provider routing, sent as-is as the request's "provider" field. The default skips
# fp4/int4 endpoints, which are cheaper but noticeably worse at long agentic runs, when the model
# has a better one (see routing_for). Set to {} to let OpenRouter pick any endpoint.
ROUTING=${PI_VM_ROUTING:-'{"quantizations":["fp16","bf16","fp8"]}'}
IMAGE=${PI_VM_IMAGE:-localhost/pi-vm:latest}
RUNTIME=${PI_VM_RUNTIME:-krun}          # set to runc/crun to run as a plain container
MEMORY=${PI_VM_MEMORY:-2g}
CPUS=${PI_VM_CPUS:-2}
TIMEOUT_MIN=${PI_VM_TIMEOUT_MIN:-90}    # the VM is killed after this many minutes
STALL_MIN=${PI_VM_STALL_MIN:-15}        # ...or after this many minutes with no file changed (0: off)
DISK_MAX_GB=${PI_VM_DISK_MAX_GB:-20}     # stop when the run dir uses more than this many GB (0: off)
MIN_FREE_GB=${PI_VM_MIN_FREE_GB:-2}      # ...or its disk has less than this many GB free (0: off)
# The VM reaches the internet but not this computer: pasta without the gateway and
# host.containers.internal mappings to the host. (It can still reach other machines on the LAN.)
NETWORK=${PI_VM_NETWORK:-pasta:--no-map-gw,--map-guest-addr,none}
RUNS=${PI_VM_RUNS:-${XDG_CACHE_HOME:-$HOME/.cache}/pi-vm/runs}
# npm's download cache and ~/.cache, kept between runs (podman volumes) so `npm ci` and
# Playwright/Puppeteer browser downloads happen once. Each repo gets its own pair
# (<name>-<repo hash>): a run can tamper with its caches, so runs of one repo must never hand
# anything to runs of another. Old ones: podman volume ls --filter name=pi-vm-
NPM_CACHE=${PI_VM_NPM_CACHE:-pi-vm-npm}
HOME_CACHE=${PI_VM_CACHE:-pi-vm-cache}
KEY_FILE=$HOME/.bashrc.d/openrouter.sh

die() { echo "pi-vm: $*" >&2; exit 1; }

# A run dir must sit directly inside $RUNS, so apply/clean never touch anything else.
run_dir() {
  local dir
  dir=$(realpath -e -- "${1:?run dir required}") || die "no such run: $1"
  [[ $(dirname -- "$dir") == "$(realpath -m -- "$RUNS")" ]] || die "not a run dir under $RUNS: $1"
  printf '%s\n' "$dir"
}

# The commit a run started from, recorded by the host at clone time (outside the run dir, which
# the VM can rewrite). Never asked of the run dir's own git.
base_file() { printf '%s/.base/%s\n' "$RUNS" "$(basename -- "$1")"; }
run_base() {
  local base; base=$(cat -- "$(base_file "$1")" 2>/dev/null) \
    || die "no base commit recorded for $1 (made by an older pi-vm); apply by hand"
  [[ $base =~ ^[0-9a-f]{40}$ ]] || die "bad base commit recorded for $1"
  printf '%s\n' "$base"
}

# The run's changes since its base as a binary patch on stdout, staged and diffed by git inside a
# throwaway VM with no network. Host git never runs in the run dir: the agent controls its .git
# (hooks, core.fsmonitor, filter and diff drivers), and host git would run whatever it planted.
export_patch() {
  local dir=$1 base; base=$(run_base "$dir")
  podman run --rm --runtime "$RUNTIME" --network none -v "$dir:/work:Z" -w /work "$IMAGE" \
    sh -c 'git add -A && git diff --cached --binary "$1" -- . ":(exclude).handoff"' sh "$base"
}

# A file the VM could have written, read only when it is a regular file in a real directory: a
# planted symlink would otherwise make the host read or copy any file it can reach.
vm_regular_file() { [[ ! -L $(dirname -- "$1") && -f $1 && ! -L $1 ]]; }

# Print OpenRouter's public metadata for a model as one JSON object, or fail if it doesn't exist.
model_info() {
  local id=$1
  curl -fsS --max-time 20 https://openrouter.ai/api/v1/models \
    | jq -ce --arg id "$id" '.data[] | select(.id == $id)' \
    || die "model '$id' not found on OpenRouter (see https://openrouter.ai/models)"
}

# pi's models.json for one OpenRouter model. pi's built-in OpenRouter list lags behind new models,
# so pi-vm always describes the model itself, from OpenRouter's own metadata (prices in $/M tokens,
# so pi's cost totals are right).
models_json() {
  jq -n --argjson m "$1" --argjson routing "$2" '
    def per_m: ((. // "0") | tonumber) * 1000000;
    { providers: { openrouter: { models: [ {
        id: $m.id,
        name: $m.name,
        reasoning: (($m.supported_parameters // []) | index("reasoning") != null),
        input: (if (($m.architecture.input_modalities // []) | index("image")) then ["text","image"] else ["text"] end),
        contextWindow: $m.context_length,
        maxTokens: ($m.top_provider.max_completion_tokens // 32000),
        cost: { input: ($m.pricing.prompt | per_m), output: ($m.pricing.completion | per_m),
                cacheRead: ($m.pricing.input_cache_read | per_m),
                cacheWrite: ($m.pricing.input_cache_write | per_m) },
        compat: ({ openRouterRouting: $routing } | if $routing == {} then {} else . end)
    } ] } } }'
}

# The OpenRouter routing for one run. Each upstream provider keeps its own prompt cache, and left to
# itself OpenRouter moves a model between providers mid-run; every move re-sends the whole history
# uncached (in a 36-minute test run, 3 moves were 70% of the fresh input tokens). So pi-vm ranks
# the model's providers once, before the run, and sends that fixed order: the first one serves every
# call, and the next ones are used only when it fails. Ranked: up now, supports tools and caching,
# an allowed quantization; then the model maker's own endpoint first (xiaomi/* for a xiaomi/
# model: in tests it held its cache across a whole run, where a reseller missed it internally),
# then most reliable over the last day, then cheapest. A PI_VM_ROUTING that names providers itself
# (order or only) is used as is.
routing_for() {
  local model=$1 eps
  if jq -e 'has("order") or has("only")' <<<"$ROUTING" >/dev/null; then echo "$ROUTING"; return; fi
  eps=$(curl -fsS --max-time 20 "https://openrouter.ai/api/v1/models/$model/endpoints") \
    || { echo "pi-vm: couldn't list providers for $model; letting OpenRouter choose" >&2; echo "$ROUTING"; return; }
  # A quantization filter that rules out every endpoint would only fail at the first model call,
  # with a 404 that doesn't say why. The filter is a preference, not a ban: when no endpoint passes
  # it (free and preview endpoints often report "unknown", and some models are served only in fp4),
  # it is dropped for this run and the run says which quantizations it allowed.
  local quant
  quant=$(jq -r --argjson r "$ROUTING" '
    ($r.quantizations // null) as $q
    | [.data.endpoints[] | select((.status // 0) == 0)] as $up
    | if $q == null or ($up | length) == 0
        or any($up[]; .quantization as $x | $q | index($x)) then "ok"
      else [$up[] | "\(.tag)=\(.quantization // "unknown")"] | join(", ")
      end' <<<"$eps")
  if [[ $quant != ok ]]; then
    echo "pi-vm: no endpoint of $model is $(jq -r '.quantizations | join("/")' <<<"$ROUTING") (it has: $quant); allowing any for this run" >&2
    ROUTING=$(jq -c 'del(.quantizations)' <<<"$ROUTING")
  fi
  jq -c --argjson r "$ROUTING" --arg maker "${model%%/*}" '
    ($r.quantizations // null) as $q
    | [.data.endpoints[]
       | select((.status // 0) == 0)
       | select($q == null or (.quantization as $x | $q | index($x)))
       | select((.supported_parameters // []) | index("tools"))
       | select(.pricing.input_cache_read != null)]
    | sort_by((.tag | split("/")[0] | ascii_downcase) != ($maker | ascii_downcase),
              -((.uptime_last_1d // 0) | floor), (.pricing.prompt | tonumber))
    | map(.tag) as $order
    | if ($order | length) == 0 then $r else $r + {order: $order, allow_fallbacks: true} end' <<<"$eps"
}

cmd_run() {
  local model=$MODEL thinking=$THINKING mode=plan
  while [[ ${1:-} == --* ]]; do
    case $1 in
      --model) model=${2:?--model needs an OpenRouter model ID}; shift 2 ;;
      --thinking) thinking=${2:?--thinking needs a level}; shift 2 ;;
      --routing) ROUTING=${2:?--routing needs a JSON object}; shift 2 ;;
      --brief) mode=brief; shift ;;
      *) die "unknown option $1" ;;
    esac
  done
  local prompt=${1:?prompt required}
  if [[ $mode == brief ]]; then
    prompt="Work from the brief below. The repository is checked out at /work; do the work there.

$prompt

There is no plan and no acceptance test to satisfy. Use your own judgement about what to
change. When you have finished, write a short note to .handoff/report.md saying what you made,
what you checked, and anything you left undone."
  fi
  case $thinking in off|minimal|low|medium|high|xhigh) ;; *) die "bad --thinking: $thinking" ;; esac
  jq -e 'type == "object"' <<<"$ROUTING" >/dev/null 2>&1 || die "bad routing (not a JSON object): $ROUTING"
  [[ -n ${OPENROUTER_API_KEY:-} ]] || die "OPENROUTER_API_KEY is not set (run: pi-vm set-key)"
  local repo; repo=$(git rev-parse --show-toplevel) || die "not in a git repo"
  [[ $mode == brief || -f $repo/.handoff/plan.md ]] || die "$repo/.handoff/plan.md not found"
  local info; info=$(model_info "$model")
  local routing; routing=$(routing_for "$model")

  local dir; dir="$RUNS/$(basename -- "$repo")-$(date +%Y%m%d-%H%M%S)"
  mkdir -p -- "$RUNS"
  # --no-hardlinks: the VM must not be able to reach the repo's object files.
  git clone -q --no-hardlinks -- "$repo" "$dir"
  git -C "$dir" remote remove origin
  mkdir -p -- "$RUNS/.base"
  git -C "$repo" rev-parse HEAD >"$(base_file "$dir")"
  local cache_key; cache_key=$(printf '%s' "$repo" | sha256sum | cut -c1-12)
  mkdir -p -- "$dir/.handoff"
  if [[ -d $repo/.handoff ]]; then cp -a -- "$repo/.handoff/." "$dir/.handoff/"; fi
  rm -f -- "$dir/.handoff/"{report.md,last-run.log,events.jsonl,run.json}
  # Outside the clone, so pi can't edit its own model config mid-run.
  local agent_dir="$dir.pi"
  mkdir -p -- "$agent_dir"
  models_json "$info" "$routing" >"$agent_dir/models.json"
  jq -n --arg model "$model" --arg thinking "$thinking" --arg mode "$mode" --argjson routing "$routing" \
    '{model: $model, thinking: $thinking, mode: $mode, routing: $routing}' >"$dir/.handoff/run.json"

  echo "$dir"
  echo "pi-vm: model $model, thinking $thinking"
  jq -r 'if .order then "pi-vm: providers, in order: \(.order | join(", "))" else empty end' <<<"$routing"
  local status=0 started=$SECONDS stalled=0 name; name="pi-vm-$(basename -- "$dir")"
  local log="$dir/.handoff/last-run.log"
  # The host writes the log only through this descriptor, opened before the VM starts: a symlink
  # the agent plants at that path later can't redirect the host's own status lines.
  exec 3>>"$log"
  say() { echo "$*"; echo "$*" >&3; }
  # podman runs in the background so the stall watchdog below can stop it. Background jobs
  # ignore Ctrl+C in a script, so pass it (and TERM) on to the VM.
  trap 'podman stop -t 5 "$name" >/dev/null 2>&1; exit 130' INT TERM
  podman run --rm --runtime "$RUNTIME" --memory "$MEMORY" --cpus "$CPUS" \
    --timeout "$((TIMEOUT_MIN * 60))" --name "$name" --network "$NETWORK" \
    -e OPENROUTER_API_KEY -e PI_VM_MODEL="$model" -e PI_VM_THINKING="$thinking" \
    -v "$dir:/work:Z" -v "$agent_dir/models.json:/root/.pi/agent/models.json:ro,Z" \
    -v "$NPM_CACHE-$cache_key:/root/.npm" -v "$HOME_CACHE-$cache_key:/root/.cache" -w /work "$IMAGE" \
    pi-run "$prompt" >&3 2>&1 &
  local pid=$! ticks=0
  # Stall watchdog: every minute, if no file in the run dir (other than .git and .handoff, where
  # the log and events keep growing) changed in the last STALL_MIN minutes, the agent is looping
  # without progress, so stop the VM.
  # Disk watchdog, same minute: stop when the run dir passes DISK_MAX_GB (du doesn't follow
  # symlinks) or the disk holding it has less than MIN_FREE_GB free.
  local reason used free
  while kill -0 "$pid" 2>/dev/null; do
    sleep 5; ticks=$((ticks + 1))
    (( ticks % 12 == 0 )) || continue
    kill -0 "$pid" 2>/dev/null || break
    reason=
    if (( STALL_MIN > 0 )) && [[ -z $(find "$dir" -path "$dir/.git" -prune -o -path "$dir/.handoff" -prune \
                 -o -newermt "-$STALL_MIN minutes" -print -quit 2>/dev/null) ]]; then
      reason="stalled: no file changed in $STALL_MIN minutes"
    elif (( DISK_MAX_GB > 0 )) && used=$(du -sx -B1 -- "$dir" 2>/dev/null | cut -f1) \
         && [[ $used =~ ^[0-9]+$ ]] && (( used > DISK_MAX_GB * 1024 ** 3 )); then
      reason="stopped: the run used more than $DISK_MAX_GB GB of disk"
    elif (( MIN_FREE_GB > 0 )) && free=$(df -B1 --output=avail -- "$dir" 2>/dev/null | tail -n1 | tr -d ' ') \
         && [[ $free =~ ^[0-9]+$ ]] && (( free < MIN_FREE_GB * 1024 ** 3 )); then
      reason="stopped: less than $MIN_FREE_GB GB of disk left"
    fi
    if [[ -n $reason ]]; then
      stalled=1
      say "pi-vm: $reason; the VM was stopped"
      podman stop -t 10 "$name" >/dev/null 2>&1 || true
      break
    fi
  done
  wait "$pid" || status=$?
  trap - INT TERM
  if (( stalled )); then
    (( status )) || status=124
  elif (( status != 0 && SECONDS - started >= TIMEOUT_MIN * 60 )); then
    say "pi-vm: timed out after $TIMEOUT_MIN minutes; the VM was stopped"
  fi
  exec 3>&-
  echo "pi-vm: exited $status; log in $dir/.handoff/last-run.log"
  return "$status"
}

cmd_apply() {
  local dir; dir=$(run_dir "${1:-}")
  local repo; repo=$(git rev-parse --show-toplevel) || die "not in a git repo"
  local base; base=$(run_base "$dir")
  [[ $(git -C "$repo" rev-parse HEAD) == "$base" ]] || die "repo HEAD moved since the run; apply by hand"
  [[ -z $(git -C "$repo" status --porcelain -- . ':(exclude).handoff') ]] \
    || die "repo has uncommitted changes; commit or stash first"
  # Everything in the clone (respecting .gitignore) since the base, including anything the agent
  # committed, replayed as unstaged changes; new files land untracked. The patch is made in a VM
  # (export_patch); git apply refuses paths outside the repo, inside .git or behind a symlink.
  local patch; patch=$(mktemp)
  export_patch "$dir" >"$patch" || { rm -f -- "$patch"; die "couldn't export the run's changes"; }
  git -C "$repo" apply --allow-empty "$patch" || { rm -f -- "$patch"; die "the patch didn't apply"; }
  rm -f -- "$patch"
  # The repo may have no .handoff/ (brief mode needs no plan), so make it before copying.
  mkdir -p -- "$repo/.handoff"
  for f in report.md last-run.log; do
    if vm_regular_file "$dir/.handoff/$f"; then cp -- "$dir/.handoff/$f" "$repo/.handoff/$f"; fi
  done
  git -C "$repo" status --short
}

cmd_diff() {
  local dir; dir=$(run_dir "${1:-}")
  if [[ ${2:-} == --stat ]]; then
    export_patch "$dir" | git apply --stat --allow-empty -
  else
    export_patch "$dir"
  fi
}

# Run a command in a VM on the run's files: for Acceptance checks, whose code the agent wrote and
# which must not run on the host. Network as in a run, no API key, no caches.
cmd_exec() {
  local dir; dir=$(run_dir "${1:-}"); shift
  [[ ${1:-} == -- ]] && shift
  (( $# )) || die "exec: command required"
  podman run --rm --runtime "$RUNTIME" --memory "$MEMORY" --cpus "$CPUS" --network "$NETWORK" \
    --timeout "$((TIMEOUT_MIN * 60))" -v "$dir:/work:Z" -w /work "$IMAGE" \
    sh -c 'if command -v no-ipv6 >/dev/null; then exec no-ipv6 "$@"; else exec "$@"; fi' sh "$@"
}

cmd_clean() {
  if [[ ${1:-} == --all ]]; then
    rm -rf -- "${RUNS:?}"/* "$RUNS/.base"
  else
    local dir; dir=$(run_dir "${1:-}")
    rm -rf -- "$dir" "$dir.pi"; rm -f -- "$(base_file "$dir")"
  fi
}

cmd_list() { ls -1 -- "$RUNS" 2>/dev/null | grep -v '\.pi$' || true; }

cmd_log() {
  local dir
  if [[ -n ${1:-} ]]; then
    dir=$(run_dir "$1")
  else
    dir=$(ls -1td -- "$RUNS"/*/ 2>/dev/null | grep -v '\.pi/$' | head -1) || true
    [[ -n $dir ]] || die "no runs in $RUNS"
    dir=${dir%/}
  fi
  echo "== $dir/.handoff/last-run.log (Ctrl+C stops watching; the run keeps going)" >&2
  tail -n +1 -F -- "$dir/.handoff/last-run.log"
}

cmd_model() {
  local id=${1:-$MODEL}
  model_info "$id" | jq -r --arg thinking "$THINKING" --arg dflt "$MODEL" '
    def per_m: ((. // "0") | tonumber) * 1000000 | . * 1000 | round / 1000;
    "\(.id)\(if .id == $dflt then "  (default, thinking \($thinking))" else "" end)",
    "  \(.name)",
    "  context \(.context_length) tokens",
    "  $/M tokens: input \(.pricing.prompt | per_m), output \(.pricing.completion | per_m), cached input \(.pricing.input_cache_read | per_m)",
    "  reasoning: \(if ((.supported_parameters // []) | index("reasoning")) then "yes" else "no" end)"'
}

cmd_set_key() {
  local key
  read -rsp "OpenRouter API key (input hidden): " key; echo
  [[ $key == sk-or-* ]] || die "that doesn't look like an OpenRouter key (sk-or-...); nothing saved"
  mkdir -p -- "$(dirname -- "$KEY_FILE")"
  ( umask 077; printf 'export OPENROUTER_API_KEY=%q\n' "$key" >"$KEY_FILE" )
  chmod 600 -- "$KEY_FILE"
  echo "Saved to $KEY_FILE (mode 600). New shells pick it up; for this one run: source $KEY_FILE"
  echo "Restart Claude Code from a new shell so it sees the key."
}

cmd_build() {
  local here; here=$(dirname -- "$(realpath -- "$0")")
  podman build --pull=newer -t "$IMAGE" "$@" "$here/../image" && podman image prune -f >/dev/null
}

# The image pins pi (PI_VERSION in image/Containerfile) so a pi release can't change a handoff
# mid-project. update rebuilds with the newest pi on npm, only when it is newer than the image's.
cmd_update() {
  local latest current
  latest=$(curl -fsS --max-time 20 https://registry.npmjs.org/@earendil-works/pi-coding-agent/latest | jq -r .version) \
    || die "couldn't reach the npm registry"
  # pi prints its version on stderr.
  current=$(podman run --rm --runtime "$RUNTIME" "$IMAGE" pi --version 2>&1 | tail -n1) || current=
  [[ -n $current ]] || current=none
  if [[ $current == "$latest" ]]; then
    echo "pi $current is the latest; nothing to do"
    return
  fi
  echo "pi in the image: $current; latest: $latest. Rebuilding."
  cmd_build --build-arg "PI_VERSION=$latest"
  echo "pi $latest installed. To make it the default for fresh builds, set PI_VERSION=$latest in image/Containerfile."
}

case ${1:-} in
  run|apply|diff|exec|clean|list|log|model|build|update) cmd=$1; shift; "cmd_$cmd" "$@" ;;
  brief) shift; cmd_run --brief "$@" ;;
  set-key) shift; cmd_set_key "$@" ;;
  *) sed -n '2,23s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
